# Copy to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local database — from `supabase status` after `supabase start`
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Anthropic — required
ANTHROPIC_API_KEY=your-anthropic-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Test database — for integration tests
SUPABASE_TEST_URL=http://127.0.0.1:54321

# Postmark inbound webhook HTTP Basic Auth password (chunk 6.3a)
# Postmark authenticates inbound webhooks via Basic Auth credentials in
# the webhook URL (https://postmark:<password>@host/...); it sends no
# body signature. Username is fixed: postmark.
POSTMARK_INBOUND_BASIC_AUTH_PASSWORD=your-postmark-inbound-secret

# Modal OCR sidecar HMAC secret (chunk 7.1b)
# Shared secret between Next.js app and Modal sidecar; used to sign
# X-Auth-HMAC header on TS->sidecar HTTP calls per ADR-0014 §3.
# Generated via sidecar-ocr/generate-secret.sh; propagated to Modal
# via `modal secret create modal-ocr-hmac-secret value=<secret>`.
# v1 manual rotation per sidecar-ocr/README.md.
MODAL_OCR_HMAC_SECRET=your-modal-ocr-hmac-secret

# Modal OCR sidecar deployed endpoint URL (chunk 7.1b)
# Modal-generated URL post-`modal deploy` from sidecar-ocr/.
# E2E test gate (sidecarE2E.integration.test.ts) requires both
# MODAL_OCR_HMAC_SECRET and MODAL_OCR_SIDECAR_URL set; absent in CI
# by default per v1 manual-trigger design intent.
MODAL_OCR_SIDECAR_URL=your-modal-sidecar-endpoint-url

# Charter B (a) sharepoint_drive storage provider — app-only Microsoft
# Graph auth via a client CERTIFICATE (not a secret). OPTIONAL until
# SharePoint activation (plan Task 8): the provider is inert until the
# resolver activates it, so these are NOT boot-required; graphClient.ts
# reads them lazily and errors only when the provider is actually used.
# The app registration must hold ONLY Sites.Selected (no broader
# co-grant) per ADR-0013 2026-06-07 amendment + spec D-B2.
GRAPH_TENANT_ID=your-entra-tenant-id
GRAPH_CLIENT_ID=your-app-registration-client-id
GRAPH_CLIENT_CERT_PATH=/path/to/graph-client-cert.pem
